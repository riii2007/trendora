				"dev",
				"--",
				"--host",
				"0.0.0.0",
				"--port",
				"5173"
			],
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Install Trendora Client Dependencies",
			"type": "shell",
			"command": "npm",
			"args": [
				"install",
